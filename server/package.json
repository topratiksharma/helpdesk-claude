{
  "name": "@helpdesk/server",
  "version": "1.0.0",
  "scripts": {
    "postinstall": "~/.bun/bin/bun run node_modules/prisma/build/index.js generate",
    "dev": "~/.bun/bin/bun --watch src/index.ts",
    "start": "~/.bun/bin/bun src/index.ts",
    "db:migrate": "~/.bun/bin/bun run node_modules/prisma/build/index.js migrate dev",
    "db:push": "~/.bun/bin/bun run node_modules/prisma/build/index.js db push",
    "db:generate": "~/.bun/bin/bun run node_modules/prisma/build/index.js generate",
    "db:seed": "~/.bun/bin/bun src/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/client-runtime-utils": "^7.8.0",
    "better-auth": "^1.6.9",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "pg": "^8.20.0",
    "prisma": "^7.8.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "typescript": "^5.7.2"
  }
}
